# Copy this file to .env.local, then fill in the required values.
MONGODB_URI=
# Generate a unique secret with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Register these callback URLs with each OAuth provider:
# http://localhost:3000/api/auth/oauth/google/callback
# http://localhost:3000/api/auth/oauth/github/callback

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASS=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
